#!/usr/bin/env bash
#MISE description="Generate sqlc, Go OpenAPI, and frontend OpenAPI code"
set -euo pipefail

cd backend
go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 generate
go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.8.0 --config openapi/oapi-codegen.yaml openapi/openapi.yaml
cd ../frontend
npm run generate:api
